	"packageManager": "pnpm@11.22.0",
	"scripts": {
		"dev": "next dev --turbopack",
		"build": "next build",
		"start": "next start",
		"lint": "biome lint",
		"test": "pnpm run test:unit",
		"test:unit": "node --import tsx --test tests/unit/*.test.ts",
		"test:e2e": "playwright test",
		"biome:fix": "biome check --write",
		"biome:fix-unsafe": "biome check --unsafe --write",
		"prepare": "lefthook install || true",
		"seed": "convex run seed:seed",
		"ext:dev": "pnpm --dir chrome-extension run dev",
		"ext:build": "pnpm --dir chrome-extension run build",
		"ext:pack": "cd chrome-extension && node scripts/pack.mjs"
	},
