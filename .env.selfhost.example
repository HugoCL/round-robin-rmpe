# ---------------------------------------------------------------------------
# La Lista — self-hosted configuration.
# Copy to `.env` (docker compose reads that automatically) and fill in.
# `./scripts/selfhost.sh bootstrap` generates the machine-made values for you.
# ---------------------------------------------------------------------------

# --- Public URLs -----------------------------------------------------------
# How the BROWSER reaches each service. On a single host behind a reverse
# proxy, use your real hostnames — these end up in the client bundle, in
# Convex action callbacks, and in the Chrome extension.
#   CONVEX_CLOUD_ORIGIN -> backend port 3210 (queries/mutations/websocket)
#   CONVEX_SITE_ORIGIN  -> backend port 3211 (HTTP actions, e.g. /flash-assign)
CONVEX_CLOUD_ORIGIN=http://127.0.0.1:3210
CONVEX_SITE_ORIGIN=http://127.0.0.1:3211

# --- Host port bindings ----------------------------------------------------
WEB_PORT=3000
CONVEX_PORT=3210
CONVEX_SITE_PORT=3211
CONVEX_DASHBOARD_PORT=6791

# --- Postgres --------------------------------------------------------------
# The database name is fixed at `convex_self_hosted` (derived from the
# Convex instance name); don't change it.
POSTGRES_USER=convex
# Generated by bootstrap if left empty.
POSTGRES_PASSWORD=

# --- Convex backend --------------------------------------------------------
CONVEX_BACKEND_VERSION=latest
# 64 hex chars. Pin it so admin keys survive losing the data volume.
CONVEX_INSTANCE_SECRET=
# Filled in by `./scripts/selfhost.sh admin-key`.
CONVEX_SELF_HOSTED_ADMIN_KEY=

# --- Clerk (hosted SaaS — no self-host option) -----------------------------
# From the Clerk dashboard. CLERK_JWT_ISSUER_DOMAIN is the Issuer URL of your
# JWT template named exactly "convex".
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_ISSUER_DOMAIN=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Web push (PWA notifications) — optional -------------------------------
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@example.com

# --- Optional integrations -------------------------------------------------
# Comma-separated emails allowed into admin-only surfaces.
ADMIN_ALLOWLIST_EMAILS=
# AI-generated Google Chat messages. Omitted = feature stays off.
GOOGLE_GENERATIVE_AI_API_KEY=
# Landing page imagery.
UNSPLASH_ACCESS_KEY=

# --- Tuning ----------------------------------------------------------------
# Postgres runs inside the compose network, so TLS is not required.
DO_NOT_REQUIRE_SSL=1
DISABLE_BEACON=1
RUST_LOG=info
